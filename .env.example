# =============================================================================
# Music Evolution - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
POSTGRES_USER=musicevo
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=musicevo

# Full database URL (constructed from above in docker-compose)
# For local development without Docker:
# DATABASE_URL=postgres://musicevo:devpassword@localhost:5432/musicevo

# -----------------------------------------------------------------------------
# Web Server Configuration
# -----------------------------------------------------------------------------
# Port to expose the proxy on (local development)
HTTP_PORT=8080
# HTTPS_PORT=8443

# -----------------------------------------------------------------------------
# Mode Configuration
# -----------------------------------------------------------------------------
# Production mode: reproduction handled by external job runner (systemd timer)
# Development mode: reproduction triggered by rating threshold
PRODUCTION_MODE=false

# Path to reproduction status JSON file (written by job runner, read by app)
# Development: not used (threshold-based reproduction)
# Production: /srv/shared/jobs/music-evo/current_status.json
REPRODUCTION_STATUS_FILE=/app/reproduction_status.json

# -----------------------------------------------------------------------------
# TLS/SSL Configuration (Production only)
# -----------------------------------------------------------------------------
# Your domain name (for TLS certificate)
# DOMAIN=music-evo.example.com

# Path to TLS certificates
# TLS_CERT_PATH=/srv/services/music-evo/certs/fullchain.pem
# TLS_KEY_PATH=/srv/services/music-evo/certs/privkey.pem
