# =============================================================================
# Music Evolution Job Runner Configuration
# =============================================================================
# Copy this file to /etc/music-evo/jobrunner.env on martin
# Adjust values as needed for your deployment
# =============================================================================

# -----------------------------------------------------------------------------
# Reproduction Interval
# -----------------------------------------------------------------------------
# How often to trigger reproduction (in seconds)
# The job runner checks more frequently but only submits jobs at this interval
# Default: 300 (5 minutes)
REPRO_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# Database Connection
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# IMPORTANT: This must be reachable from both martin and worker nodes
DATABASE_URL=postgres://musicevo:YOUR_PASSWORD@martin:5432/musicevo

# -----------------------------------------------------------------------------
# Paths
# -----------------------------------------------------------------------------
# Directory for job status files and logs (must be on NFS)
JOBS_DIR=/srv/shared/jobs/music-evo

# Directory for WAV output files (must be on NFS, readable by web app)
WAV_DIR=/srv/shared/music-evo/current_generation

# Path to the sbatch script
SBATCH_SCRIPT=/srv/services/music-evo/scripts/run-reproduction.sbatch

# -----------------------------------------------------------------------------
# Slurm Configuration
# -----------------------------------------------------------------------------
# Slurm partition to use
SLURM_PARTITION=musicevo

# -----------------------------------------------------------------------------
# Apptainer/Singularity (for worker nodes)
# -----------------------------------------------------------------------------
# Path to apptainer binary (on workers)
APPTAINER_BIN=/srv/shared/apptainer/bin/apptainer

# Path to the SIF container image
SIF_IMAGE=/srv/shared/images/music-evo.sif

# Alternative: path to native binary (if not using containers)
# NATIVE_BINARY=/srv/shared/music-evo/bin/reproduce
