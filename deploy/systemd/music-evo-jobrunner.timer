[Unit]
Description=Music Evolution Job Runner Timer
Documentation=file:///srv/services/music-evo/docs/slurm-offload.md

[Timer]
# Run every minute
# The jobrunner script itself enforces the REPRO_INTERVAL_SECONDS
OnBootSec=1min
OnUnitActiveSec=1min

# Randomize slightly to avoid thundering herd
RandomizedDelaySec=5

# Persist timer state across reboots
Persistent=true

[Install]
WantedBy=timers.target
